# ---------------------------------------------------------------------------
# Document Verifier -- environment
#
#   cp .env.example .env
#
# Every value has a working default in app/config.py, so a local run needs no
# .env at all. Copy it when you want Postgres, a real OCR engine, or the LLM.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Unset -> SQLite at data/verifier.sqlite3 (zero setup).
# DATABASE_URL=postgresql+psycopg://verifier:verifier@localhost:5432/verifier

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# --- OCR -------------------------------------------------------------------
# pp-ocrv5     -> PaddleOCR PP-OCRv5, in-process (uv sync --extra ocr)
# paddleocr-vl -> PaddleOCR-VL 1.5 served by the `ocr-vl` container (docker compose --profile vl up)
# stub         -> fixture text, no models; the default for tests/CI
OCR_ENGINE=pp-ocrv5
OCR_LANG=en
OCR_VL_BASE_URL=http://localhost:8118

# --- LLM (local Ollama, OpenAI-compatible API) -----------------------------
# Off -> regex extraction only. Never point this at a third-party API:
# resumes and ID cards do not leave the machine.
#   ollama pull gemma4:e4b
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT_SECONDS=180

# --- Matching engine -------------------------------------------------------
# auto -> spaCy when en_core_web_md is installed, else TF-IDF
MATCHING_BACKEND=auto
SPACY_MODEL=en_core_web_md
# DEFAULT_SIMILARITY_THRESHOLD=

# --- Name verification -----------------------------------------------------
# token_set_ratio score (0-100): >= match -> "match"; >= review -> "review"; else "mismatch"
NAME_MATCH_THRESHOLD=85
NAME_REVIEW_THRESHOLD=70
