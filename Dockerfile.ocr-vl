# PaddleOCR-VL 1.5 behind a small HTTP server, CPU only. Benchmark use:
# the image is large (several GB of models download on first run).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "paddlepaddle==3.3.1" \
    && pip install --no-cache-dir "paddleocr[doc-parser]>=3.7" fastapi "uvicorn[standard]" python-multipart

WORKDIR /srv
COPY ocr_vl_server ./ocr_vl_server

EXPOSE 8118
CMD ["uvicorn", "ocr_vl_server.server:app", "--host", "0.0.0.0", "--port", "8118"]
